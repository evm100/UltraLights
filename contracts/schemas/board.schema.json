{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lights.evm100.org/contracts/v1/board.schema.json",
  "title": "Board descriptor",
  "description": "What is physically connected to which pin. Written by the node builder, stored on the node in the ul_board partition and on the server. Pin rules beyond this schema are in chips.json and are checked by both the builder and ul_board.",
  "type": "object",
  "required": ["v", "chip", "board", "channels"],
  "additionalProperties": false,
  "properties": {
    "v": { "const": 1 },
    "chip": { "$ref": "common.schema.json#/$defs/chip" },
    "board": { "$ref": "common.schema.json#/$defs/name", "description": "Human name, e.g. 'PCB rev A' or 'Legacy C3: kitchen'." },
    "hw_rev": { "type": "string", "maxLength": 16 },
    "channels": { "type": "array", "maxItems": 16, "items": { "$ref": "#/$defs/channel" } },
    "reset_button": {
      "type": "object", "additionalProperties": false, "required": ["gpio"],
      "properties": {
        "gpio": { "$ref": "common.schema.json#/$defs/gpio" },
        "active_low": { "type": "boolean", "default": true },
        "hold_ms": { "type": "integer", "minimum": 1000, "maximum": 30000, "default": 5000 }
      }
    },
    "status_led": {
      "type": "object", "additionalProperties": false, "required": ["gpio"],
      "properties": {
        "gpio": { "$ref": "common.schema.json#/$defs/gpio" },
        "active_low": { "type": "boolean", "default": false }
      }
    }
  },
  "$defs": {
    "channel": {
      "type": "object",
      "required": ["id", "type", "gpio"],
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/key" },
        "name": { "$ref": "common.schema.json#/$defs/name" },
        "type": { "enum": ["pwm", "argb", "switch", "motion", "servo"] },
        "gpio": { "$ref": "common.schema.json#/$defs/gpio" }
      },
      "oneOf": [
        { "properties": {
            "type": { "const": "pwm" },
            "id": true, "name": true, "gpio": true,
            "hz": { "type": "integer", "minimum": 100, "maximum": 40000, "default": 19000 },
            "invert": { "type": "boolean", "default": false }
          }, "additionalProperties": false },
        { "required": ["pixels"], "properties": {
            "type": { "const": "argb" },
            "id": true, "name": true, "gpio": true,
            "pixels": { "type": "integer", "minimum": 1, "maximum": 1500 },
            "order": { "$ref": "common.schema.json#/$defs/pixel_order", "default": "GRB" },
            "chipset": { "enum": ["ws2812", "sk6812", "ws2811"], "default": "ws2812" }
          }, "additionalProperties": false },
        { "properties": {
            "type": { "const": "switch" },
            "id": true, "name": true, "gpio": true,
            "active_low": { "type": "boolean", "default": false }
          }, "additionalProperties": false },
        { "properties": {
            "type": { "const": "motion" },
            "id": true, "name": true, "gpio": true,
            "active_low": { "type": "boolean", "default": false }
          }, "additionalProperties": false },
        { "required": ["press_deg", "rest_deg", "hold_ms"],
          "description": "A hobby servo that presses an appliance's own mode button (50 Hz, 500-2500 us for 0-180 degrees). One press is: move to press_deg, hold hold_ms (travel included), go back to rest_deg, wait release_ms, then stop the signal. The appliance steps off -> modes[0] -> ... -> modes[n-1] -> off on each press.",
          "properties": {
            "type": { "const": "servo" },
            "id": true, "name": true, "gpio": true,
            "press_deg": { "type": "integer", "minimum": 0, "maximum": 180, "description": "Angle that pushes the button." },
            "rest_deg": { "type": "integer", "minimum": 0, "maximum": 180, "description": "Angle clear of the button, where the arm waits." },
            "hold_ms": { "type": "integer", "minimum": 20, "maximum": 5000, "description": "Time from leaving rest to starting back, travel included." },
            "release_ms": { "type": "integer", "minimum": 50, "maximum": 5000, "default": 400, "description": "Time to get back to rest and let the appliance register the press before the next one." },
            "modes": { "$ref": "#/$defs/modes", "default": ["on"] }
          }, "additionalProperties": false }
      ]
    },
    "modes": {
      "type": "array", "minItems": 1, "maxItems": 7, "uniqueItems": true,
      "items": { "allOf": [{ "$ref": "common.schema.json#/$defs/key" }, { "not": { "const": "off" } }] },
      "description": "The appliance's modes in button order, starting with the one after off. Off is implicit and comes after the last. Default [\"on\"]: one press toggles."
    }
  }
}
