{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lights.evm100.org/contracts/v1/ws-server.schema.json",
  "title": "Server to browser WebSocket message (/api/ws)",
  "description": "snapshot first, then incremental updates, each filtered to what the viewer may see. health and evt go to admins only; device views carry an admin block only for admins. Close code 4001 means the viewer's access changed: reconnect for a fresh snapshot.",
  "type": "object",
  "required": ["t"],
  "oneOf": [
    { "required": ["devices"], "properties": { "t": { "const": "snapshot" }, "devices": { "type": "array", "items": { "$ref": "#/$defs/device" } }, "broker": { "type": "boolean" } }, "additionalProperties": false },
    { "required": ["device"], "properties": { "t": { "const": "device" }, "device": { "$ref": "#/$defs/device" } }, "additionalProperties": false },
    { "required": ["dev", "out", "state"], "properties": { "t": { "const": "state" }, "dev": { "$ref": "common.schema.json#/$defs/device_id" }, "out": { "$ref": "common.schema.json#/$defs/key" }, "state": { "$ref": "state.schema.json" } }, "additionalProperties": false },
    { "required": ["dev", "health"], "properties": { "t": { "const": "health" }, "dev": { "$ref": "common.schema.json#/$defs/device_id" }, "health": { "$ref": "health.schema.json" } }, "additionalProperties": false },
    { "required": ["dev", "evt"], "properties": { "t": { "const": "evt" }, "dev": { "$ref": "common.schema.json#/$defs/device_id" }, "evt": { "$ref": "evt.schema.json" } }, "additionalProperties": false },
    { "required": ["error"], "properties": { "t": { "const": "error" }, "error": { "enum": ["invalid", "no_such_output", "broker_offline", "forbidden"] }, "detail": { "type": "string" }, "dev": { "$ref": "common.schema.json#/$defs/device_id" }, "out": { "$ref": "common.schema.json#/$defs/key" } }, "additionalProperties": false },
    { "properties": { "t": { "const": "pong" } }, "additionalProperties": false }
  ],
  "$defs": {
    "device": {
      "type": "object",
      "required": ["id", "name", "chip", "home_id", "online", "outputs"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/device_id" },
        "name": { "type": "string" },
        "chip": { "oneOf": [ { "$ref": "common.schema.json#/$defs/chip" }, { "type": "null" } ], "description": "null for a bridged device." },
        "kind": { "enum": ["node", "bridge"] },
        "combined": { "type": "boolean", "description": "Show the outputs as one light with a part picker (a bridged PC)." },
        "home_id": { "type": ["integer", "null"] },
        "online": { "type": "boolean" },
        "outputs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["key", "kind", "name", "caps", "room_id", "meta", "state", "desired", "can"],
            "additionalProperties": false,
            "properties": {
              "key": { "$ref": "common.schema.json#/$defs/key" },
              "kind": { "$ref": "common.schema.json#/$defs/kind" },
              "name": { "type": "string" },
              "caps": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/cap" } },
              "room_id": { "type": ["integer", "null"] },
              "meta": { "type": "object", "description": "cct_range, pixels, max_level, channels from a node's info; part, source, leds, reachable from a bridge's." },
              "state": { "oneOf": [ { "type": "null" }, { "$ref": "state.schema.json" } ] },
              "desired": { "oneOf": [ { "type": "null" }, { "$ref": "set.schema.json" } ] },
              "can": {
                "type": "array", "uniqueItems": true,
                "items": { "enum": ["view", "control", "color"] },
                "description": "What this viewer may do: view; control (on/off, level, fades, pulses); color (color, white, warmth, effects). Outputs without view are never sent."
              }
            }
          }
        },
        "admin": {
          "type": "object",
          "description": "Admins only.",
          "properties": {
            "board": { "type": ["string", "null"] },
            "bridge": { "type": ["string", "null"] },
            "host": { "type": ["string", "null"] },
            "sources": { "type": "array" },
            "fw": { "type": ["string", "null"] },
            "profile": { "type": ["string", "null"] },
            "board_crc": { "type": ["string", "null"] },
            "running_crc": { "type": ["string", "null"] },
            "config_rev": { "type": "integer" },
            "running_config_rev": { "type": ["integer", "null"] },
            "config_error": { "type": ["string", "null"] },
            "enrolled": { "type": "boolean" },
            "last_seen": { "type": ["string", "null"] },
            "health": { "oneOf": [ { "type": "null" }, { "$ref": "health.schema.json" } ] }
          },
          "additionalProperties": false
        }
      }
    }
  }
}
