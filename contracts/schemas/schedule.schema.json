{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lights.evm100.org/contracts/v1/schedule.schema.json",
  "title": "Schedule document (REST /api/homes/{id}/schedules, stored by the server)",
  "description": "When something happens in one home, in the home's time zone. The scheduler service decides when; the API does it, with src sched:<id>. With until, the targets are switched off again at that time (an on/off window, e.g. sunset to 23:00). A run missed while the server was down is skipped, not replayed late.",
  "type": "object",
  "required": ["v", "name", "at", "do"],
  "additionalProperties": false,
  "properties": {
    "v": { "const": 1 },
    "name": { "type": "string", "minLength": 1, "maxLength": 48 },
    "enabled": { "type": "boolean", "default": true },
    "days": {
      "type": "array", "items": { "type": "integer", "minimum": 0, "maximum": 6 }, "uniqueItems": true, "minItems": 1,
      "description": "Weekdays it starts on, 0 = Monday. Absent = every day."
    },
    "at": { "$ref": "#/$defs/when" },
    "until": { "$ref": "#/$defs/when", "description": "Switch the targets off again at this time (the same day, or the next if it falls earlier). Not for valves, which close on their own." },
    "do": {
      "oneOf": [
        { "type": "object", "required": ["scene"], "additionalProperties": false,
          "properties": { "scene": { "type": "integer" } }, "description": "Apply a scene of this home." },
        { "type": "object", "required": ["room", "on"], "additionalProperties": false,
          "properties": { "room": { "type": "integer" }, "on": { "type": "boolean" } }, "description": "A room's lights on or off, as the room toggle." },
        { "type": "object", "required": ["dev", "out", "on"], "additionalProperties": false,
          "properties": { "dev": { "$ref": "common.schema.json#/$defs/device_id" }, "out": { "$ref": "common.schema.json#/$defs/key" }, "on": { "type": "boolean" } },
          "description": "One light or relay on or off." },
        { "type": "object", "required": ["dev", "out", "run_ms"], "additionalProperties": false,
          "properties": { "dev": { "$ref": "common.schema.json#/$defs/device_id" }, "out": { "$ref": "common.schema.json#/$defs/key" },
                          "run_ms": { "type": "integer", "minimum": 60000, "maximum": 7200000 } },
          "description": "Open a valve for run_ms (capped by its limit)." }
      ]
    }
  },
  "$defs": {
    "when": {
      "oneOf": [
        { "type": "object", "required": ["time"], "additionalProperties": false,
          "properties": { "time": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" } } },
        { "type": "object", "required": ["sun"], "additionalProperties": false,
          "properties": { "sun": { "enum": ["sunrise", "sunset"] }, "offset_min": { "type": "integer", "minimum": -180, "maximum": 180, "default": 0 } },
          "description": "Needs the home's location." }
      ]
    }
  }
}
