{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lights.evm100.org/contracts/v1/cmd.schema.json",
  "title": "One-shot command (topic ul/v1/d/{id}/cmd, never retained, QoS 1, server to device)",
  "description": "Every command is answered with an evt of type cmd_result carrying the same id. Commands older than 30 s by the device clock (if synced) are rejected with error 'stale'.",
  "type": "object",
  "required": ["id", "op"],
  "properties": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9-]{8,40}$" },
    "op": { "enum": ["identify", "reboot", "wifi_reset", "factory_reset", "pulse", "ota", "selftest", "close"] },
    "ts": { "type": "integer", "description": "Server unix time in seconds when sent." },
    "src": { "$ref": "common.schema.json#/$defs/src" }
  },
  "oneOf": [
    { "properties": { "id": true, "op": { "const": "identify" }, "ts": true, "src": true, "ms": { "type": "integer", "minimum": 500, "maximum": 60000, "default": 5000 }, "out": { "$ref": "common.schema.json#/$defs/key", "description": "Blink this output; absent = status LED or all outputs." } }, "additionalProperties": false },
    { "properties": { "id": true, "op": { "const": "reboot" }, "ts": true, "src": true }, "additionalProperties": false },
    { "properties": { "id": true, "op": { "const": "wifi_reset" }, "ts": true, "src": true }, "additionalProperties": false, "description": "Forget Wi-Fi and DNS, keep identity, open the setup page." },
    { "properties": { "id": true, "op": { "const": "factory_reset" }, "ts": true, "src": true, "confirm": { "const": true } }, "required": ["confirm"], "additionalProperties": false, "description": "Erase Wi-Fi, identity and saved state. The node needs a new token to enroll again." },
    { "required": ["out", "ms"], "properties": { "id": true, "op": { "const": "pulse" }, "ts": true, "src": true, "out": { "$ref": "common.schema.json#/$defs/key" }, "ms": { "type": "integer", "minimum": 10, "maximum": 7200000, "description": "Clamped to the output's max_on_ms (at most 2 h)." } }, "additionalProperties": false },
    { "required": ["url", "sha256", "version"], "properties": { "id": true, "op": { "const": "ota" }, "ts": true, "src": true, "url": { "type": "string", "pattern": "^https://" }, "sha256": { "$ref": "common.schema.json#/$defs/sha256" }, "version": { "$ref": "common.schema.json#/$defs/semver" } }, "additionalProperties": false },
    { "properties": { "id": true, "op": { "const": "selftest" }, "ts": true, "src": true }, "additionalProperties": false },
    { "required": ["out"], "properties": { "id": true, "op": { "const": "close" }, "ts": true, "src": true, "out": { "$ref": "common.schema.json#/$defs/key" } }, "additionalProperties": false, "description": "Solenoid only: end the running pulse now (no-op if closed)." }
  ]
}
